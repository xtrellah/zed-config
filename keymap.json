[
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": [
        "terminal::SendText",
        "\u001b\r"
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-shift-f": "editor::Format"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-shift-i": "editor::Format"
    }
  },
  {
    "bindings": {
      "cmd-h": "editor::ToggleAllDiffHunks",
      "cmd-'": "editor::ToggleAllDiffHunks"
    }
  }
]
